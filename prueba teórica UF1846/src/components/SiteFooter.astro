---
const year = new Date().getFullYear();

const enlaces = [
  { href: '/', label: 'Inicio' },
  { href: '/about', label: 'Sobre mí' },
  { href: '/blog', label: 'Blog' },
  { href: '/contacto', label: 'Contacto' },
];
---

<footer class="mt-16 bg-cabecera text-claro">
  <div class="mx-auto flex w-[92%] max-w-7xl flex-col items-center gap-8 px-4 py-12">
    <nav class="flex flex-wrap justify-center gap-6 text-sm">
      {enlaces.map(function crearEnlace(enlace) {
        return (
          <a href={enlace.href} class="text-claro/80 hover:text-white transition-colors">
            {enlace.label}
          </a>
        );
      })}
    </nav>

    <div class="flex gap-3">
      <a
        href="mailto:1moussijoelle@gmail.com"
        class="flex h-10 w-10 items-center justify-center rounded-md border border-claro/40 text-claro hover:border-white hover:text-white transition-colors"
        aria-label="Correo electrónico"
        title="Email"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
          <path d="M4 6h16v12H4z" />
          <path d="m4 7 8 6 8-6" />
        </svg>
      </a>
      <a
        href="https://wa.me/34631714141"
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-10 w-10 items-center justify-center rounded-md border border-claro/40 text-claro hover:border-white hover:text-white transition-colors"
        aria-label="WhatsApp"
        title="WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.38A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 0 1 6.9 12.3 8.05 8.05 0 0 1-6.9 3.5 8 8 0 0 1-3.65-.87l-.26-.14-3.11.82.83-3.03-.17-.28a8.1 8.1 0 0 1 6.36-11.3Zm4.56 10.3c-.07-.12-.4-.25-.84-.45s-.5-.12-.72.13-.66.83-.81 1-.3.2-.55.07a6.6 6.6 0 0 1-1.94-1.2 7.3 7.3 0 0 1-1.35-1.68c-.14-.25 0-.38.11-.5.11-.12.25-.3.37-.45s.16-.25.25-.42.04-.3-.02-.43-.72-1.73-.98-2.37c-.26-.62-.52-.53-.72-.54h-.61c-.2 0-.43.08-.66.3s-.86.84-.86 2.05.88 2.38 1 2.55a8.7 8.7 0 0 0 3.35 2.9c1.27.55 1.67.48 1.98.45.3-.03.94-.38 1.07-.75s.14-.68.1-.75Z" />
        </svg>
      </a>
      <a
        href="https://github.com/moussijoelle"
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-10 w-10 items-center justify-center rounded-md border border-claro/40 text-claro hover:border-white hover:text-white transition-colors"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.1-1.5-1.1-1.5-.9-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 7.5c.85 0 1.7.12 2.5.35 1.9-1.32 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .26.18.59.69.48A10.02 10.02 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" />
        </svg>
      </a>
    </div>

    <p class="text-xs text-claro/60">
      Copyright © {year} Frente a la sociedad
    </p>
  </div>
</footer>
