---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ordenarPorFechaMasReciente, formatearFecha } from '../../utils/blog';

const posts = await getCollection('posts');
const ordenados = posts.sort(ordenarPorFechaMasReciente);
const ultimo = ordenados[0];
const etiqueta = ultimo ? ultimo.data.tags[0] : null;
---

<Layout
  title="Blog — Frente a la sociedad"
  description="Reflexiones sobre amor, alegría, salud mental, identidad y la sociedad."
>
  <section class="space-y-12">
    <div class="space-y-3 border-b border-white/20 pb-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-acento-claro">
        Reflexiones
      </p>
      <h1 class="text-3xl font-bold text-white md:text-4xl">Blog</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-white/85">
        Aquí encontrarás reflexiones honestas sobre amor, alegría, salud mental,
        identidad y todo lo que callamos frente a la sociedad.
      </p>
    </div>

    {ultimo && (
      <article class="space-y-5 rounded-3xl border border-linea bg-papel p-5 transition-shadow hover:border-acento/40 hover:shadow-md md:p-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-acento">
          Artículo destacado
        </p>

        <a href={`/blog/${ultimo.id}`} class="block overflow-hidden rounded-3xl">
          <img
            src={ultimo.data.image.url}
            alt={ultimo.data.image.alt}
            class="aspect-video w-full object-cover"
          />
        </a>

        <div class="flex flex-wrap items-center gap-2 text-sm text-suave">
          <span>{ultimo.data.author} · {formatearFecha(ultimo.data.pubDate)}</span>
          {etiqueta && (
            <span class="rounded-full bg-acento-claro px-2.5 py-0.5 text-xs font-semibold text-acento">
              {etiqueta}
            </span>
          )}
        </div>

        <h2 class="text-2xl font-bold text-tinta md:text-3xl">
          <a href={`/blog/${ultimo.id}`} class="hover:text-acento transition-colors">
            {ultimo.data.title}
          </a>
        </h2>

        <p class="text-lg leading-relaxed text-tinta">
          {ultimo.data.description}
        </p>

        <a
          href={`/blog/${ultimo.id}`}
          class="inline-flex text-sm font-semibold text-acento hover:text-acento-oscuro"
        >
          Leer artículo completo →
        </a>
      </article>
    )}

    <div class="text-center">
      <a
        href="/blog/1"
        class="inline-block rounded-xl bg-acento px-6 py-3.5 text-sm font-semibold text-papel shadow-sm hover:bg-acento-oscuro transition-colors"
      >
        Ver todos los artículos
      </a>
    </div>
  </section>
</Layout>
